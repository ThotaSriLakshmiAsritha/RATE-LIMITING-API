{
  "uid": "rate-limiting",
  "title": "Rate Limiting",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Rate limit checks (allowed vs rejected)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "sum by (result) (rate(rate_limit_checks_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate limit check latency (p95)",
      "gridPos": { "x": 0, "y": 10, "w": 24, "h": 10 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rate_limit_check_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        }
      ]
    }
  ],
  "templating": { "list": [] }
}

